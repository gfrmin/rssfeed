; ============================================================
; model.bdsl — rssfeed's preference model: BAYESIAN LINEAR REGRESSION.
;
; A pure BDSL program driven over the Credence skin wire. The earlier version
; treated each engagement as an independent direct measurement of every active
; feature's weight (naive-Bayes style) — which double-counts evidence across
; co-occurring features and has no explaining-away, so one thumb-down on a single
; post dragged down the WHOLE feed/author. This model fixes that: it treats one
; engagement as a single noisy measurement of the SCORE,
;
;     y  ~  Normal( Σ wᵢ·xᵢ ,  σ² ),
;
; and does the exact conjugate (Kalman / Bayesian-linear-regression) measurement
; update. The prediction error is SHARED across the active features in proportion
; to each one's variance (uncertainty) and damped by the noise term, so a
; confident, well-liked source barely moves on a one-off negative while an
; uncertain feature absorbs it.
;
; The inference runs NATIVELY in the engine: the (MvGaussianPrevision,
; LinearGaussian) conjugate (credence src/conjugate.jl) does the exact Kalman
; update, so `observe` is a single `condition` — no hand-rolled posterior
; arithmetic here, no probability math in Python. The active weights cross the
; wire as a joint {type:mv_gaussian, mu, sigma} belief-spec and the conditioned
; belief crosses back the same way; rssfeed persists the per-feature {mu, sigma}
; marginals (diag Σ) in Postgres. Feature *semantics* (which index is which
; feed/author/tag) live in Python.
; ============================================================

; ── observe: one joint linear-Gaussian (Kalman/BLR) measurement update ──
; weights : the active features' joint weight belief — an MvGaussianMeasure
;           (built from a {type:mv_gaussian, mu, sigma} spec; sigma is Σ's rows).
; xs      : the article's feature values for those features (the LinearGaussian
;           coefficients a in y ~ N(aᵀw, σ²)).
; y       : the engagement target (e.g. +1 star/up, −1 down, graded dwell).
; sigma   : σ, the observation-noise stddev on the score.
; Returns the conditioned MvGaussianMeasure (serialised back as an mv_gaussian
; belief-spec). The engine's conjugate keeps the full off-diagonal Σ'; rssfeed
; reads off the per-feature marginals it persists.
(define observe
  (lambda (weights xs y sigma)
    (condition weights
      (kernel (space :euclidean (length xs)) (space :euclidean 1)
              (lambda (w) (lambda (o) o))
              :family linear-gaussian xs sigma)
      y)))

; ── score ONE article: Σ meanᵢ·featureᵢ ──
; means: positional weight means (host's name→index order). features: same order.
(define score
  (lambda (means features)
    (fold-init + 0.0
      (map (lambda (i) (* (nth means i) (nth features i)))
           (range (length means))))))

; ── score a BATCH of articles → numeric vector in input order ──
(define score-batch
  (lambda (means articles)
    (map (lambda (a) (score means a)) articles)))

; ── per-feature contributions for ONE article (transparency / "why ranked") ──
; Returns [meanᵢ·featureᵢ]; the score is its sum.
(define contributions
  (lambda (means features)
    (map (lambda (i) (* (nth means i) (nth features i)))
         (range (length means)))))
