; ============================================================
; model.bdsl — rssfeed's parametric MAUT preference model.
;
; A PURE BDSL program driven over the Credence skin wire (decouple Move 2).
; Every function here is pure: it takes beliefs — reconstructed at the wire from
; declarative {type, params} specs — and returns beliefs or numbers. There is NO
; state and NO raw-parameter access here: the model speaks beliefs (mean/condition),
; the skin speaks params (serialization), and rssfeed holds the durable store
; (Postgres). Mirrors ~/git/credence/examples/maut_demo.bdsl.
;
; Each FEATURE (feed:<id>, author:<slug>, tag:<slug>, recency, priority) has a
; signed WEIGHT belief (Gaussian). An ENGAGEMENT SIGNAL conditions the active
; features' weights via the kernel below; the host (app/ranker_client.py) maps the
; signal to a signed evidence scalar (star/thumb_up → +, thumb_down → −, dwell →
; graded). An article SCORE is Σ mean(wᵢ)·featureᵢ. Feature *semantics* (which
; index is which feed/author/tag) live in Python as a name→index map; here weights
; are a positional list, so the model stays structurally domain-neutral.
; ============================================================

; ── A graded-evidence kernel for a signed (Gaussian) weight ──
; The observation IS the signed evidence value; σ is the declared observation
; noise. `:family normal 0.5` exposes the NormalNormal conjugate update — so a
; positive obs pulls a weight up, a negative obs pulls it down.
(define signed-kernel
  (kernel (space :euclidean 1) (space :euclidean 1)
          (lambda (mu) (lambda (o) o))
          :family normal 0.5))

; ── observe-batch: condition a list of ACTIVE weights on one signed obs ──
; The host passes only the weights of the features present in the engaged article,
; all updated by the same evidence. Pure: beliefs in, beliefs out (a list of
; belief-specs crosses the wire as a list of {type, params}).
(define observe-batch
  (lambda (weights obs)
    (map (lambda (w) (condition w signed-kernel obs)) weights)))

; ── score ONE article ──
; weights: positional list of weight beliefs. features: the article's feature
; values in the same order. Returns Σ mean(wᵢ)·featureᵢ. Reads beliefs through
; `mean` only — never raw μ/σ.
(define score
  (lambda (weights features)
    (fold-init + 0.0
      (map (lambda (i) (* (mean (nth weights i)) (nth features i)))
           (range (length weights))))))

; ── score a BATCH of articles ──
; articles: a list of feature-lists (host's name→index order). Returns a numeric
; vector of scores in input order; crosses the wire as {value: [...]}.
(define score-batch
  (lambda (weights articles)
    (map (lambda (a) (score weights a)) articles)))

; ── per-feature contributions for ONE article (transparency / "why ranked") ──
; Returns the vector [mean(wᵢ)·featureᵢ] — the score is its sum. The host maps the
; positions back to feature names and surfaces the largest ± contributors.
(define contributions
  (lambda (weights features)
    (map (lambda (i) (* (mean (nth weights i)) (nth features i)))
         (range (length weights)))))
