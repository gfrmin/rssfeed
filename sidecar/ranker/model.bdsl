; ============================================================
; model.bdsl — rssfeed's preference model: BAYESIAN LINEAR REGRESSION.
;
; A pure BDSL program driven over the Credence skin wire. The earlier version
; treated each engagement as an independent direct measurement of every active
; feature's weight (naive-Bayes style) — which double-counts evidence across
; co-occurring features and has no explaining-away, so one thumb-down on a single
; post dragged down the WHOLE feed/author. This model fixes that: it treats one
; engagement as a single noisy measurement of the SCORE,
;
;     y  ~  Normal( Σ wᵢ·xᵢ ,  σ² ),
;
; and does the exact conjugate (rank-1 Kalman / Bayesian-linear-regression)
; measurement update. The prediction error is SHARED across the active features in
; proportion to each one's variance (uncertainty) and damped by the noise term, so
; a confident, well-liked source barely moves on a one-off negative while an
; uncertain feature absorbs it.
;
; The engine has no linear-Gaussian conjugate and BDSL can't read a belief's
; variance, so the closed form is computed here in the model (the inference logic
; still lives in rssfeed, not Python). Weights are passed as plain (mean, variance)
; number lists; rssfeed holds the durable {mu, sigma} store in Postgres. Feature
; *semantics* (which index is which feed/author/tag) live in Python.
; ============================================================

; ── observe-blr: one rank-1 BLR/Kalman measurement update ──
; means, vars : the active features' weight marginals (Gaussian).
; xs          : the article's feature values for those features.
; y           : the engagement target (e.g. +1 star/up, −1 down, graded dwell).
; noise       : σ², the observation noise on the score.
; Returns a length-2k numeric vector: [updated-means… , updated-vars…].
;   ŷ = Σ xᵢmᵢ ;  s = σ² + Σ xᵢ²vᵢ ;  gain gᵢ = xᵢvᵢ/s
;   mᵢ' = mᵢ + gᵢ(y−ŷ) ;  vᵢ' = vᵢ − gᵢ·xᵢvᵢ
(define observe-blr
  (lambda (means vars xs y noise)
    (let k (length means)
    (let yhat (fold-init + 0.0
                (map (lambda (i) (* (nth xs i) (nth means i))) (range k)))
    (let s (+ noise (fold-init + 0.0
                (map (lambda (i) (* (* (nth xs i) (nth xs i)) (nth vars i))) (range k))))
    (let r (- y yhat)
      (map (lambda (j)
             (if (> k j)
                 ; updated MEAN for feature j: mⱼ + (xⱼvⱼ/s)·r
                 (+ (nth means j) (/ (* (* (nth xs j) (nth vars j)) r) s))
                 ; updated VARIANCE for feature (j−k): vᵢ − (xᵢvᵢ)²/s
                 (let i (- j k)
                 (let xv (* (nth xs i) (nth vars i))
                   (- (nth vars i) (/ (* xv xv) s))))))
           (range (+ k k)))))))))

; ── score ONE article: Σ meanᵢ·featureᵢ ──
; means: positional weight means (host's name→index order). features: same order.
(define score
  (lambda (means features)
    (fold-init + 0.0
      (map (lambda (i) (* (nth means i) (nth features i)))
           (range (length means))))))

; ── score a BATCH of articles → numeric vector in input order ──
(define score-batch
  (lambda (means articles)
    (map (lambda (a) (score means a)) articles)))

; ── per-feature contributions for ONE article (transparency / "why ranked") ──
; Returns [meanᵢ·featureᵢ]; the score is its sum.
(define contributions
  (lambda (means features)
    (map (lambda (i) (* (nth means i) (nth features i)))
         (range (length means)))))
