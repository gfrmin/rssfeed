# systemd user unit for the cross-feed ranker runner.
# Install:  cp rssfeed-ranker.service ~/.config/systemd/user/
#           systemctl --user enable --now rssfeed-ranker
# Requires run.jl to exist (the credence-side deliverable) and Julia on PATH.
#
# Start the sidecar AFTER this so load_state() finds the runner warm; either way the
# sidecar tolerates the runner being absent (it falls back to priority+recency).

[Unit]
Description=rssfeed cross-feed ranker (credence runner)
After=network.target

[Service]
Type=simple
Environment=CREDENCE_SRC=/home/g/git/credence
EnvironmentFile=/home/g/git/rssfeed/.env
ExecStart=/usr/bin/julia --project=/home/g/git/credence /home/g/git/rssfeed/sidecar/ranker/run.jl
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
