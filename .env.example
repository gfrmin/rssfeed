POSTGRES_PASSWORD=miniflux

# Where the sidecar listens. Loopback by default ON PURPOSE: the reader has no
# authentication of its own, so anyone who can reach the port can read your
# subscriptions, your article archive and your saved logins. Only widen this
# deliberately -- to a VPN/tailnet address, or behind a reverse proxy that
# authenticates. Avoid 0.0.0.0 unless you have a firewall you trust.
# RSSFEED_BIND=127.0.0.1
# RSSFEED_PORT=9145

# Host port Postgres is published on (see docker-compose.yml). Only change this
# if you changed it there too -- the systemd unit's readiness probe uses it.
# RSSFEED_DB_PORT=5433

# Set this to override the whole connection string (e.g. an external Postgres).
# Left unset, it is built from POSTGRES_PASSWORD and RSSFEED_DB_PORT.
# DATABASE_URL=
MINIFLUX_ADMIN_USER=admin
MINIFLUX_ADMIN_PASSWORD=changeme
MINIFLUX_API_KEY=

# Full-text extraction proxies (optional)
BRIGHTDATA_PROXY=
BRIGHTDATA_UNLOCKER_PROXY=

# Per-site login recipes (optional). Deliberately outside the repo: the set of
# sites you can log into is the set of subscriptions you hold. Copy
# sidecar/config/login-recipes.example.json to this path to add your own.
# Without it, logins use generic heuristics — enough for most plain login forms.
# LOGIN_RECIPES_FILE=~/.config/rssfeed/login-recipes.json

# Learning ranker (optional — falls back to priority+recency if the engine is down)
# RANKER_ENABLED=1
# CREDENCE_SKIN_SERVER=~/git/credence/apps/skin/server.jl
# CREDENCE_SKIN_PROJECT=~/git/credence
# Use the pinned image instead of a local Julia checkout (JSON argv):
# CREDENCE_SKIN_COMMAND=["docker","run","--rm","-i","ghcr.io/gfrmin/credence-skin:latest"]

# Embedding similarity (optional — needs Ollama; absent feature if it's down)
# EMBED_ENABLED=1
# OLLAMA_URL=http://localhost:11434
# EMBED_MODEL=nomic-embed-text
