[Unit]
Description=RSS Feed Sidecar (standby/failover copy, thinkpad)
# Not enabled/WantedBy anything — this only ever gets started explicitly by
# scripts/promote-standby.sh, after the standby db has been promoted to
# writable. Starting it against a still-read-only standby will just error on
# every write (star/read/mark actions) until promotion happens.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/git/rssfeed/sidecar
EnvironmentFile=%h/git/rssfeed/.env
Environment=MINIFLUX_URL=http://localhost:9144
# Invidious runs on steel — if steel itself is down (not just its Postgres),
# this will be unreachable too. That's fine: the ranker/embeddings path is
# documented as optional and fail-open, and Invidious link embeds should
# degrade the same way.
Environment=INVIDIOUS_URL=http://steel:5151
# The bind below needs tailscale0 to exist and carry an address. At boot that
# is NOT guaranteed: a user manager's network-online.target is inert, so
# nothing orders us after the tailnet coming up. Wait for it explicitly.
ExecStartPre=/bin/bash -c 'for i in $(seq 60); do ip addr show tailscale0 2>/dev/null | grep -q "inet " && exit 0; sleep 2; done; echo "tailscale0 has no address after 120s"; exit 1'
ExecStartPre=/bin/bash -c 'for i in $(seq 30); do timeout 1 bash -c "cat < /dev/null > /dev/tcp/127.0.0.1/5433" 2>/dev/null && exit 0; sleep 2; done; echo "standby postgres not reachable after 60s"; exit 1'
# Bound to this host's tailnet address, not 0.0.0.0: the reader has no auth of
# its own, and neither box is guaranteed to run a host firewall, so 0.0.0.0
# would serve it to whatever LAN the machine joins. Reach it at
# http://<box>:9145 over MagicDNS (which resolves from the box itself too).
#
# TAILNET_IP comes from .env (gitignored), so this unit is host-agnostic and no
# tailnet address lands in a public repo. Escaped as $${...} so systemd passes
# it through for sh to expand; :? makes an unset value fail loudly rather than
# silently binding everywhere. Note this ties the sidecar to tailscale0 being up.
ExecStart=/bin/sh -c 'DATABASE_URL="postgres://miniflux:$${POSTGRES_PASSWORD:-miniflux}@localhost:5433/miniflux" exec /usr/bin/uv run uvicorn app.main:app --host $${TAILNET_IP:?TAILNET_IP unset in .env} --port 9145'
Restart=on-failure
RestartSec=3
# uvicorn re-raises SIGTERM's default disposition after its own graceful
# shutdown, so a clean `systemctl stop` exits 143, not 0 — without this,
# every intentional stop (e.g. failback freezing writes) is recorded as
# `failed` instead of `inactive`.
SuccessExitStatus=143
